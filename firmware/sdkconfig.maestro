# Maestro development build. Keep the board recoverable over USB.
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_HOMEHUB_NVS_ENCRYPTION=n
CONFIG_NVS_ENCRYPTION=n
CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH=n
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
# Needed for USB screenshots during bring-up.
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Resolve the Mac's Bonjour name; DHCP changes do not need a firmware update.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
