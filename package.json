{
  "name": "maestro-stopwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "setup": "node --import tsx bridge/src/setup.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test bridge/test/*.test.ts",
    "doctor": "node --import tsx bridge/src/doctor.ts",
    "firmware:prepare": "python3 scripts/prepare-firmware.py",
    "firmware:build": "bash scripts/build-firmware.sh"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
