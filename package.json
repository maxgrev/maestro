{
  "name": "maestro-stopwatch",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "setup": "node --import tsx bridge/src/setup.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test bridge/test/*.test.ts",
    "doctor": "node --import tsx bridge/src/doctor.ts",
    "firmware:prepare": "python3 scripts/prepare-firmware.py",
    "firmware:build": "bash scripts/build-firmware.sh",
    "app:build": "python3.13 scripts/package-mac.py",
    "storage:clean": "python3.13 scripts/clean-builds.py",
    "release:source": "python3.13 scripts/package-source.py"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "fastify": "5.12.8",
    "ipaddr.js": "2.5.0",
    "marked": "18.1.0",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
